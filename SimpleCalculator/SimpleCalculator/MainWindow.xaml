<Window x:Class="SimpleCalculator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Simple Calculator" Height="350" Width="400" Background="LightGreen">
    <Grid>
        <Label Content="VU ID: BS1234567" HorizontalAlignment="Center" VerticalAlignment="Top" Background="Orange" Height="40" Width="350" FontSize="16" />

        <Label Content="Enter First Number" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="50,60,0,0" />
        <TextBox Name="txtFirstNumber" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,60,50,0" Width="120" />

        <Label Content="Enter Second Number" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="50,100,0,0" />
        <TextBox Name="txtSecondNumber" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,100,50,0" Width="120" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,160,0,0">
            <Button Name="btnAdd" Content="Add" Width="100" Click="btnAdd_Click" Margin="10" />
            <Button Name="btnMultiply" Content="Multiply" Width="100" Click="btnMultiply_Click" Margin="10" />
            <Button Name="btnClear" Content="Clear" Width="100" Click="btnClear_Click" Margin="10" />
        </StackPanel>

        <Label Content="Result:" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="50,220,0,0" />
        <TextBox Name="txtResult" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,220,50,0" Width="120" Background="LightPink" IsReadOnly="True" />
    </Grid>
</Window>
